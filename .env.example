# Public configuration
GOOGLE_REDIRECT_URI=https://cascadepaintingpa.com/api/google/callback
GOOGLE_BUSINESS_NAME=Cascade Painting

# Keep each value below in Cloudflare as an encrypted secret.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_SETUP_PASSWORD=replace-with-at-least-32-random-characters
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64

# Optional only if discovery finds more than one exact Cascade Painting match.
# GOOGLE_ACCOUNT_ID=replace-with-account-id
# GOOGLE_LOCATION_ID=replace-with-location-id
