{
  "name": "cascade-painting",
  "compatibility_date": "2026-09-07",
  "main": "./worker/index.js",
  "keep_vars": true,
  "vars": {
    "GOOGLE_REDIRECT_URI": "https://cascadepaintingpa.com/api/google/callback",
    "GOOGLE_BUSINESS_NAME": "Cascade Painting"
  },
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "6ddaac49-4306-4d42-8989-141606abd87f"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "GOOGLE_REVIEWS_CACHE",
      "id": "25ee2e286a64a833a85bfa0b9ae2af5f"
    }
  ]
}
