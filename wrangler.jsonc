{
  "name": "cascade-painting",
  "compatibility_date": "2026-09-07",
  "main": "./worker/index.js",
  "keep_vars": true,

  "routes": [
    {
      "pattern": "cascadepaintingpa.com",
      "custom_domain": true
    },
    {
      "pattern": "www.cascadepaintingpa.com",
      "custom_domain": true
    }
  ],

  "vars": {
    "GOOGLE_REDIRECT_URI": "https://cascadepaintingpa.com/api/google/callback",
    "GOOGLE_BUSINESS_NAME": "Cascade Painting"
  },

  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "6ddaca49-4306-4d42-8989-141606abd87f"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "GOOGLE_REVIEWS_CACHE",
      "id": "25ee2e2868a64833a85bfa0b9ae2af5f"
    }
  ]
}